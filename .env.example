# Copy to .env and adjust. Everything has a working default; the demo runs
# with no .env at all (`docker compose up --build`).

# Host port the UI/API is published on
MYELOVAR_PORT=8000

# --- path overrides (inside the container these already point at /app/...) ---
# MYELOVAR_DATA_DIR=data
# MYELOVAR_OUTPUTS_DIR=outputs
# MYELOVAR_DEMO_DIR=demo_bundle
# MYELOVAR_VALIDATION_DIR=validation
# MYELOVAR_WEB_DIST=web/dist
# MYELOVAR_CONFIG=config.yaml

# --- host paths mounted into the container (docker-compose volumes) ---
# Mount a real data/ tree to enable live runs (make data) inside Docker.
# MYELOVAR_DATA_HOST=./data
# MYELOVAR_OUTPUTS_HOST=./outputs
# MYELOVAR_UPLOADS_HOST=./outputs/uploads

# --- API behaviour ---
# Max VCF upload size for POST /api/runs (MB)
MYELOVAR_MAX_UPLOAD_MB=50
# Comma-separated CORS allow-list ("*" for the demo)
MYELOVAR_CORS_ORIGINS=*
# Keep uploaded VCFs after a run (default false: uploads are removed)
MYELOVAR_STORE_UPLOADS=false
